# StockDotFun V2 indexer (Ponder). Copy to .env.local and fill after V2 deploy.

# Robinhood Chain RPC (an archive/Alchemy endpoint is recommended for backfill)
PONDER_RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com

# Postgres connection string (required for `ponder start`).
# Supabase works — use the DIRECT connection (port 5432) or SESSION pooler,
# NOT the transaction pooler (port 6543): Ponder needs advisory locks +
# prepared statements, which transaction-mode pooling breaks.
#   Supabase direct:  postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#   Local/Railway:    postgresql://user:pass@host:5432/stockdotfun
DATABASE_URL=postgresql://user:pass@localhost:5432/stockdotfun

# Deployed V2 addresses (from DeployRobinhoodV2 output)
FACTORY_ADDRESS=
TREASURY_ADDRESS=
CREATOR_VAULT_ADDRESS=

# Block at which the V2 factory was deployed (for efficient backfill)
FACTORY_START_BLOCK=

# Curve graduation target in wei (matches factory CurveConfig; default 4.4e18)
GRADUATION_TARGET_WEI=4400000000000000000
