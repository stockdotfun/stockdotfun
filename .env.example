# =========================================================================
# StockDotFun — environment configuration
# Network defaults below are VERIFIED Robinhood Chain mainnet values
# (docs.robinhood.com/chain + on-chain + Blockscout, 2026-07-10).
# See docs/mainnet-verification/token-address-verification.md
# NEVER commit a real .env file. NEVER put private keys in NEXT_PUBLIC_ vars.
# =========================================================================

# ---- Network (verified defaults are built in; override only if needed) ----
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RHC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# Preferred for production throughput (falls back to public RPC if unset):
NEXT_PUBLIC_ALCHEMY_RHC_RPC_URL=

# ---- Verified base assets (official Robinhood Chain contracts) ----
NEXT_PUBLIC_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# ---- StockDotFun contracts (EMPTY until a real, reviewed deployment) ----
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_STOCK_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_REWARD_VAULT_ADDRESS=
NEXT_PUBLIC_CREATOR_REWARD_VAULT_ADDRESS=
NEXT_PUBLIC_PROTOCOL_TREASURY=

# ---- Modes ----
# Demo data is HARD-BLOCKED on chain id 4663 regardless of this flag.
NEXT_PUBLIC_DEMO_MODE=false
# /admin is disabled in production unless true:
ADMIN_ENABLED=false

# ---- V2: indexer + permanent metadata (Parts 7-9) ----
# Ponder indexer base URL; when set, Explore/Portfolio/Creator use real data:
NEXT_PUBLIC_INDEXER_URL=
# Permanent metadata via Pinata/IPFS. PINATA_JWT is SERVER-ONLY (never NEXT_PUBLIC_).
PINATA_JWT=
NEXT_PUBLIC_METADATA_CONFIGURED=false
# V2 contract addresses (from DeployRobinhoodV2 output):
NEXT_PUBLIC_V2_FACTORY_ADDRESS=
NEXT_PUBLIC_V2_STOCK_ROUTE_REGISTRY=
NEXT_PUBLIC_V2_STOCK_REWARD_TREASURY=
NEXT_PUBLIC_V2_GRADUATION_MANAGER=
NEXT_PUBLIC_VERSION_REGISTRY=

# ---- Deployment secrets (Foundry only — never exposed to the client) ----
# DEPLOYER_PRIVATE_KEY=
# RHC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# PROTOCOL_TREASURY=
# NEW_OWNER=            # multisig receiving ownership post-deploy (optional)
# DEPLOY_CHECKLIST_ACK= # must equal I_HAVE_READ_DEPLOYMENT_CHECKLIST to broadcast
# ETHERSCAN_API_KEY=
# BLOCKSCOUT_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# FLAP INTEGRATION (Robinhood Chain) — VERIFIED 2026-07-15, see
# docs/integrations/flap-robinhood-verification.md. Ships DISABLED; enable only
# after downstream phases (indexer, gateway, rewards, randomness) are verified.
# ─────────────────────────────────────────────────────────────────────────────
FLAP_INTEGRATION_ENABLED=false
FLAP_ROBINHOOD_PORTAL_ADDRESS=0x26605f322f7fF986f381bB9A6e3f5DAb0bEaEb09
FLAP_ROBINHOOD_PORTAL_LENS_ADDRESS=            # none separate on RHC — getTokenV7 is on the Portal
FLAP_ROBINHOOD_TAX_HELPER_ADDRESS=0xb10bD2672aE63735d677164A54B573a016f0203C
FLAP_ROBINHOOD_DEPLOYMENT_BLOCK=4180724
FLAP_METADATA_GATEWAY=https://ipfs.io/ipfs
FLAP_API_BASE_URL=
FLAP_CONFIRMATION_BLOCKS=20
FLAP_AUTO_LIST_ENABLED=false
FLAP_MIN_POOL_LIQUIDITY_WETH=0.5
FLAP_MIN_POOL_LIQUIDITY_USDG=
FLAP_ALLOW_TAX_TOKENS=true
FLAP_MAX_BUY_TAX_BPS=1000
FLAP_MAX_SELL_TAX_BPS=1000

NEXT_PUBLIC_FLAP_INTEGRATION_ENABLED=false
NEXT_PUBLIC_EXTERNAL_TRADE_GATEWAY_ADDRESS=    # set after gateway deploy (Phase 6)
NEXT_PUBLIC_EXTERNAL_REWARD_MANAGER_ADDRESS=   # set after reward deploy (Phase 7)
NEXT_PUBLIC_EXTERNAL_REWARD_VAULT_ADDRESS=

# Reward economics (Phase 7) — no aggressive defaults; leave blank until funded + reviewed.
EXTERNAL_TRADE_REWARD_FEE_BPS=
EXTERNAL_TRADE_REWARD_FEE_CAP_BPS=
REWARD_PAYOUT_SHARE_OF_FEE_BPS=
MIN_REWARD_ELIGIBLE_TRADE_VALUE=
MAX_REWARD_CREDITS_PER_WALLET_PER_EPOCH=
REWARD_EPOCH_DURATION=

# Indexer
INDEXER_RPC_URL=https://rpc.mainnet.chain.robinhood.com
INDEXER_START_BLOCK=4180724
